# Identiqo Django backend — environment variables
# Copy this file to .env and update values (never commit .env)

# ------------------------------------------------------------------------------
# Django core
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database
# Default: SQLite (db.sqlite3) — leave USE_POSTGRES empty or false
# Set USE_POSTGRES=true only when PostgreSQL is installed and running
# ------------------------------------------------------------------------------
USE_POSTGRES=false

DB_NAME=identiqo_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Super admin seed (optional — used by: python manage.py seed_super_admin)
# ------------------------------------------------------------------------------
# ADMIN_EMAIL=admin@identiqo.com
# ADMIN_PASSWORD=Admin@12345
# ADMIN_NAME=Super Admin
